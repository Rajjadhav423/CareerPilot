# Copy to .env (git-ignored) and fill in. Java properties format: no quotes, no trailing spaces.

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/careerpilot
DB_USERNAME=careerpilot
DB_PASSWORD=<DB_PASSWORD>

# Clerk: Dashboard -> API keys -> "Frontend API URL"
CLERK_ISSUER=https://xxxx.clerk.accounts.dev
# Clerk: Dashboard -> Webhooks -> your endpoint -> "Signing Secret" (leave empty to disable webhooks)
CLERK_WEBHOOK_SECRET=whsec_xxx
# Clerk: Dashboard -> API keys -> "Secret key" (server only; leave empty to disable Gmail sending and Google Drive)
CLERK_SECRET_KEY=sk_test_xxx

# Frontend URL(s), comma-separated. Defaults to http://localhost:3000; set to your Vercel URL in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

