# Base URL of the CareerPilot Spring Boot API
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Clerk (https://dashboard.clerk.com -> API keys). Never commit real keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# ---- Find jobs sources (server-side only: never prefix these with NEXT_PUBLIC_) ----
# Free sources need no key: company boards (Greenhouse/Lever/Ashby), Remotive, Arbeitnow, The Muse, Himalayas.
# Each keyed source below is skipped until its key is set. Results are cached per source to stay in free limits.
# Optional: higher The Muse rate limit (https://www.themuse.com/developers/api/v2)
THEMUSE_API_KEY=
# Adzuna (https://developer.adzuna.com/) — country: in, gb, us, …
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# Jooble (https://jooble.org/api/about)
JOOBLE_API_KEY=
JOOBLE_KEYWORDS=software developer
JOOBLE_LOCATION=India
# JSearch on RapidAPI (https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch) — free plan ~200 requests/month
JSEARCH_API_KEY=
JSEARCH_QUERY=software developer in India
# Findwork (https://findwork.dev/developers/)
FINDWORK_API_KEY=
# USAJOBS (https://developer.usajobs.gov/) — US federal jobs; the email you registered with
USAJOBS_API_KEY=
USAJOBS_EMAIL=
